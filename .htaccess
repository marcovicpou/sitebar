Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:storage|includes|database|node_modules|src|tests|scripts)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
</IfModule>
<FilesMatch "^(?:package(?:-lock)?\.json|tsconfig.*\.json|vite\.config.*|README.*|.*\.lock|.*\.tmp)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
